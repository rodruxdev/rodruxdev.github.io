---
import styles from '@styles/Experience.module.css';
---

<div class={styles.experience__container}>
  <div class={`${styles.experience__decoration} blue-border`}></div>
  <div class={`${styles.experience__box} orange-border`}>
    <div class={styles['experience--first']}>
      <h4>Senior Software Engineer - Niche</h4>
      <p>Sep 2026 - Present</p>
      <ul class={styles.experience__list}>
        <li>
          <p>Improved college admin tools and how calls to action appear in student messages.</p>
        </li>
        <li>
          <p>Delivered a feature across five services in one week using coding agents and structured workflows.</p>
        </li>
        <li>
          <p>Created repository-specific AI skills and helped the team adopt coding agents.</p>
        </li>
      </ul>
    </div>
    <div class={styles['experience--first']}>
      <h4>Software Engineer - Niche</h4>
      <p>Jan 2025 - Sep 2026</p>
      <ul class={styles.experience__list}>
        <li>
          <p>Built and expanded automated college messaging campaigns, including a second version that generated more than 2,000 campaigns and supported over 2 million messages in its first month.</p>
        </li>
        <li>
          <p>Improved college data extraction quality by 10% with an LLM-assisted validation and scraping workflow.</p>
        </li>
        <li>
          <p>Built a pipeline that prepared student audiences for personalized campaigns.</p>
        </li>
      </ul>
    </div>
    <div>
      <h4>Software Programmer - Goodkind</h4>
      <p>May 2024 - Jan 2025</p>
      <ul class={styles.experience__list}>
        <li>
          <p>Built scheduling, delivery, and preview features for email, SMS, and WhatsApp campaigns.</p>
        </li>
        <li>
          <p>Reworked video uploads around Mux, removing a preprocessing service and the Azure Blob Storage connection.</p>
        </li>
        <li>
          <p>Built an LLM-powered spam checker to help users improve their messages.</p>
        </li>
      </ul>
    </div>
  </div>
  <div class={`${styles.experience__box} orange-border`}>
    <div class={styles['experience--first']}>
      <h4>Fullstack Developer - Ultra</h4>
      <p>Jan 2023 - May 2024</p>
      <ul class={styles.experience__list}>
        <li>
          <p>Built and maintained CRM features with React.js and PHP, including automation for client file validation.</p>
        </li>
        <li>
          <p>Developed internal data extraction systems to support analysis.</p>
        </li>
      </ul>
    </div>
    <div>
      <h4>Frontend Developer - Freelance</h4>
      <p>Mar 2022 - Jan 2023</p>
      <ul class={styles.experience__list}>
        <li>
          <p>Built a hotel website with React.js and Next.js for promotion, bookings, and guest check-in.</p>
        </li>
        <li>
          <p>Added multilingual support and QR-code access to the hotel's exhibition pieces.</p>
        </li>
      </ul>
    </div>
  </div>
</div>
