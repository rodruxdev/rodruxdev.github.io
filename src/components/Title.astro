---
import styles from '@styles/Title.module.css';
---

<div class={styles.title}>
  <div class={`${styles.title__container} ${styles['title__decoration-blue']} blue-border`}></div>
  <div class={`${styles.title__container} ${styles['title__decoration-orange']} orange-border`}></div>
  <div class={`${styles.title__container} ${styles['title__name-container']}`}>
    <h1 class={styles.title__name}>RODRIGO GOITIA</h1>
  </div>
  <div class={`${styles.title__container} ${styles['title__nickname-container']}`}>
    <h2 class={styles.title__nickname}>RODRUX</h2>
  </div>
  <div class={`${styles.title__container} ${styles['title__position-container']}`}>
    <h3 class={styles.title__position}>FULLSTACK DEVELOPER</h3>
  </div>
</div>
