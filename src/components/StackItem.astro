---
import { FaNode, FaPython, FaReact } from 'react-icons/fa';
import { DiRedis } from 'react-icons/di';
import { SiClaudecode, SiDocker, SiGo, SiMongodb, SiNextdotjs, SiOpencode, SiPostgresql, SiTypescript } from 'react-icons/si';
import type { IconType } from 'react-icons';
import styles from '@styles/StackItem.module.css';

type StackIcon = 'ts' | 'python' | 'react' | 'next' | 'node' | 'go' | 'postgres' | 'mongo' | 'docker' | 'redis' | 'claude-code' | 'opencode';

interface Props {
  icon: StackIcon;
}

const { icon } = Astro.props;
const icons: Record<StackIcon, IconType> = {
  ts: SiTypescript,
  python: FaPython,
  react: FaReact,
  next: SiNextdotjs,
  node: FaNode,
  go: SiGo,
  postgres: SiPostgresql,
  mongo: SiMongodb,
  docker: SiDocker,
  redis: DiRedis,
  'claude-code': SiClaudecode,
  opencode: SiOpencode,
};
const Icon = icons[icon];
---

<li class={styles.stack}>
  <Icon className={styles.stack__icon} />
  <p class={styles.stack__text}><slot /></p>
</li>
