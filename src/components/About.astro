---
import styles from '@styles/About.module.css';
---

<div class={styles.about}>
  <div class={`${styles.about__decoration} orange-border`}></div>
  <div class={`${styles['about__text-container']} blue-box`}>
    <p class={styles.about__text}>
      I'm a Senior Software Engineer with 4+ years of fullstack experience. I've built messaging systems, video upload flows, and LLM-powered data tools. I use Claude Code and OpenCode to work through
      complex changes and deliver software users can rely on.
    </p>
  </div>
</div>
