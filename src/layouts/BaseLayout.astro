---
import '@styles/globals.css';

const title = 'Rodrigo Goitia | RODRUX - Fullstack Developer';
const description =
  'I am a Fullstack Developer looking to work in startups to beat climate change and reduce all types of inequalities. I develop web apps with attention to the users and the problem. I develop with curiosity, innovation and empathy to come out with simple and effective solutions.';
const siteURL = Astro.site ?? new URL('https://www.rodrux.com');
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const ogImage = new URL('/logo.png', siteURL);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL.href} />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Chakra+Petch:ital,wght@0,500;1,500&display=swap" rel="stylesheet" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage.href} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="400" />
    <meta property="og:image:height" content="400" />
    <meta property="og:image:alt" content="Rodrigo Goitia | RODRUX Logo" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:site" content="@rodruxdev" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />
    <meta name="twitter:image:alt" content="Rodrigo Goitia | RODRUX Logo" />
  </head>
  <body>
    <slot />
  </body>
</html>
