---
import StackItem from '@components/StackItem.astro';
import Subtitle from '@components/Subtitle.astro';
import styles from '@styles/Stack.module.css';
---

<div class={`${styles.stack} blue-border`}>
  <div class={styles.stack__flex}>
    <Subtitle>STACK</Subtitle>
    <ul class={styles.stack__list}>
      <StackItem icon="ts">TYPESCRIPT</StackItem>
      <StackItem icon="python">PYTHON</StackItem>
      <StackItem icon="react">REACT.JS</StackItem>
      <StackItem icon="next">NEXT.JS</StackItem>
      <StackItem icon="node">NODE.JS</StackItem>
      <StackItem icon="go">GO</StackItem>
      <StackItem icon="postgres">POSTGRESQL</StackItem>
      <StackItem icon="mongo">MONGODB</StackItem>
      <StackItem icon="docker">DOCKER</StackItem>
      <StackItem icon="redis">REDIS</StackItem>
      <StackItem icon="claude-code">CLAUDE CODE</StackItem>
      <StackItem icon="opencode">OPENCODE</StackItem>
    </ul>
  </div>
</div>
